# Copy this file to .env.dev.local (development) and .env.prod.local (production).
# Every variable must start with VITE_ to be exposed to the browser bundle.
# Never commit the real values; the *.local files are git-ignored.

# Base URL of the Workgrid backend REST API including the /api prefix, no trailing slash
VITE_SERVER_URL=https://localhost:4000/api
# Socket.IO server URL (usually the same host as the API)
VITE_SOCKET_URL=https://localhost:4000
# Public URL where the frontend is served (used for invite links and notify.js)
VITE_BASE_URL=https://localhost:8443
# Web Push VAPID *public* key (the private key lives only on the backend)
VITE_PUBLIC_VAPID=<your-vapid-public-key>

# Optional: domain appended to bare usernames at sign-in (leave empty to disable)
VITE_ACCOUNT_DOMAIN=
