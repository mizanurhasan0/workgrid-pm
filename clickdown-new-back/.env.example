# Copy this file to .env and fill in the values.
# Real environment variables take precedence over values in this file.
# To use another file (for example config/dev.env), run: ENV_FILE=config/dev.env npm run dev

# --- Required -------------------------------------------------------------
# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/workgrid or an Atlas SRV URL
MONGODB_URL=mongodb://127.0.0.1:27017/workgrid
# Secret used to sign login tokens and encrypt password-reset tokens. Use a long random string.
SECRET=change-me-to-a-long-random-string
# Name of the auth cookie
COOKIE_KEY=token
# ObjectId of the default "member" role document in the roles collection
DEFAULT_ROLE=000000000000000000000000

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=9998
# Public URLs used in links and push-notification icons
SERVER_URL=http://localhost:9998
SERVER_API=http://localhost:9998/api
# Comma-separated list of allowed browser origins (CORS and Socket.IO)
CORS_ORIGINS=http://localhost:3000
# true = HTTPS; false = plain HTTP (local development only)
USE_HTTPS=false
SSL_KEY_PATH=ssl/privatekey.pem
SSL_CERT_PATH=ssl/certificate.pem
# Default avatar path (relative to the project folder)
DEFAULT_IMAGE=images/avatar.svg

# --- Email (optional; invitations and password reset) ----------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_NAME=Workgrid
EMAIL_FROM=no-reply@example.com

# --- Web push (optional). Generate with: npx web-push generate-vapid-keys
PUBLICVAPKEY=
PRIVATEVPKEY=
VAPID_SUBJECT=mailto:admin@example.com
