{
  "name": "workgrid-backend",
  "version": "2.0.0",
  "description": "Backend API and realtime server for Workgrid (Express, Socket.IO, MongoDB).",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "babel src --out-dir dist --copy-files",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext js,html --exec babel-node src/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "seed": "babel-node src/scripts/seed-demo.js",
    "seed:data": "babel-node src/scripts/seed-sample-data.js",
    "migrate:priority": "babel-node src/scripts/migrate-priority.js",
    "migrate:reactions": "babel-node src/scripts/migrate-reactions.js"
  },
  "dependencies": {
    "@dreygur/messenger-group-avatar": "^0.0.7",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-actuator": "^1.8.4",
    "express-form-data": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "mongoose-paginate-v2": "^1.9.5",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.1",
    "peer": "^1.0.2",
    "sanitize-html": "^2.18.2",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/node": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14"
  }
}
